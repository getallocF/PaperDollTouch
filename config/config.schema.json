{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaperDollTouch Config",
  "description": "Configuration for PaperDollTouch inventory character touch rotation on Minecraft Bedrock 26.60 ARM64.",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "title": "Config Version",
      "readOnly": true,
      "default": 2
    },
    "enabled": {
      "type": "boolean",
      "title": "Enabled",
      "default": true
    },
    "sensitivityYaw": {
      "type": "number",
      "title": "Horizontal Yaw Sensitivity",
      "default": 0.55
    },
    "sensitivityPitch": {
      "type": "number",
      "title": "Vertical Pitch Sensitivity",
      "default": 0.35
    },
    "invertVertical": {
      "type": "boolean",
      "title": "Invert Vertical Drag",
      "default": false
    },
    "maxPitchDegrees": {
      "type": "number",
      "title": "Max Pitch Degrees",
      "default": 45.0
    },
    "resetOnInventoryClose": {
      "type": "boolean",
      "title": "Reset Orientation on Close",
      "default": true
    },
    "smoothingFactor": {
      "type": "number",
      "title": "Smoothing Factor",
      "default": 0.4
    },
    "boundsMinX": {
      "type": "number",
      "title": "Preview Bounds Min X",
      "default": 0.04
    },
    "boundsMinY": {
      "type": "number",
      "title": "Preview Bounds Min Y",
      "default": 0.06
    },
    "boundsMaxX": {
      "type": "number",
      "title": "Preview Bounds Max X",
      "default": 0.68
    },
    "boundsMaxY": {
      "type": "number",
      "title": "Preview Bounds Max Y",
      "default": 0.82
    },
    "expectedMinecraftVersion": {
      "type": "string",
      "title": "Expected Minecraft Version",
      "default": "26.60"
    },
    "allowSymbolAutoProbe": {
      "type": "boolean",
      "title": "Allow RTTI Vtable & Symbol Auto-Probe",
      "default": true
    },
    "allowNativeInputQueueFallback": {
      "type": "boolean",
      "title": "Allow AInputQueue Touch Hook",
      "default": true
    },
    "verifiedSignaturesReady": {
      "type": "boolean",
      "title": "Verified Signatures Ready",
      "default": false
    },
    "hudPlayerRendererRenderSig": {
      "type": "string",
      "title": "LivePlayerRenderer::render Signature Override",
      "default": ""
    },
    "getLocalPlayerFromClientSig": {
      "type": "string",
      "title": "ClientInstance::getLocalPlayer Signature Override",
      "default": ""
    },
    "actorGetRotationSig": {
      "type": "string",
      "title": "Actor::getRotation Signature Override",
      "default": ""
    },
    "actorRotYawOffset": {
      "type": "integer",
      "title": "Actor Yaw Offset",
      "default": 0
    },
    "actorRotPitchOffset": {
      "type": "integer",
      "title": "Actor Pitch Offset",
      "default": 0
    },
    "mobBodyYawOffset": {
      "type": "integer",
      "title": "Mob Body Yaw Offset",
      "default": 0
    },
    "mobHeadYawOffset": {
      "type": "integer",
      "title": "Mob Head Yaw Offset",
      "default": 0
    }
  },
  "required": [
    "version",
    "enabled",
    "sensitivityYaw",
    "sensitivityPitch",
    "invertVertical",
    "maxPitchDegrees",
    "resetOnInventoryClose",
    "smoothingFactor",
    "boundsMinX",
    "boundsMinY",
    "boundsMaxX",
    "boundsMaxY",
    "expectedMinecraftVersion",
    "allowSymbolAutoProbe",
    "allowNativeInputQueueFallback",
    "verifiedSignaturesReady",
    "hudPlayerRendererRenderSig",
    "getLocalPlayerFromClientSig",
    "actorGetRotationSig",
    "actorRotYawOffset",
    "actorRotPitchOffset",
    "mobBodyYawOffset",
    "mobHeadYawOffset"
  ]
}
