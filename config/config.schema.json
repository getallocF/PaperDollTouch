{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minecraft Mobile Cursor & PaperDollTouch Config",
  "description": "Configuration for Minecraft Mobile Cursor (Windows-Style GUI Pointer, Green Slot Hover, Mobile Cursor Settings, and PaperDoll Head Follow) on Minecraft Bedrock 26.60 ARM64.",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "title": "Config Version",
      "readOnly": true,
      "default": 4
    },
    "enabled": {
      "type": "boolean",
      "title": "Mod Master Enable",
      "default": true
    },
    "cursorEnabled": {
      "type": "boolean",
      "title": "Enable Mobile Cursor",
      "default": true
    },
    "cursorSizePreset": {
      "type": "string",
      "title": "Cursor Size Preset",
      "default": "medium"
    },
    "cursorScale": {
      "type": "number",
      "title": "Cursor Scale Slider",
      "default": 1.0
    },
    "greenSlotHoverEnabled": {
      "type": "boolean",
      "title": "Enable Green Slot Hover",
      "default": true
    },
    "paperDollFollowCursor": {
      "type": "boolean",
      "title": "PaperDoll Head Follows Cursor",
      "default": true
    },
    "hideWhenMouseConnected": {
      "type": "boolean",
      "title": "Hide When Physical Mouse Used",
      "default": true
    },
    "touchInputMode": {
      "type": "string",
      "title": "Touch Input Mode",
      "default": "direct"
    },
    "trackpadSensitivity": {
      "type": "number",
      "title": "Trackpad Sensitivity",
      "default": 1.25
    },
    "sensitivityYaw": {
      "type": "number",
      "title": "Horizontal Yaw Sensitivity",
      "default": 1.0
    },
    "sensitivityPitch": {
      "type": "number",
      "title": "Vertical Pitch Sensitivity",
      "default": 1.0
    },
    "invertVertical": {
      "type": "boolean",
      "title": "Invert Vertical Look",
      "default": false
    },
    "maxPitchDegrees": {
      "type": "number",
      "title": "Max Pitch Degrees",
      "default": 45.0
    },
    "resetOnInventoryClose": {
      "type": "boolean",
      "title": "Reset Orientation on Close",
      "default": true
    },
    "smoothingFactor": {
      "type": "number",
      "title": "Smoothing Factor",
      "default": 0.45
    },
    "boundsMinX": {
      "type": "number",
      "title": "Preview Bounds Min X",
      "default": 0.0
    },
    "boundsMinY": {
      "type": "number",
      "title": "Preview Bounds Min Y",
      "default": 0.0
    },
    "boundsMaxX": {
      "type": "number",
      "title": "Preview Bounds Max X",
      "default": 1.0
    },
    "boundsMaxY": {
      "type": "number",
      "title": "Preview Bounds Max Y",
      "default": 1.0
    },
    "expectedMinecraftVersion": {
      "type": "string",
      "title": "Expected Minecraft Version",
      "default": "26.60"
    },
    "allowSymbolAutoProbe": {
      "type": "boolean",
      "title": "Allow RTTI Vtable & Symbol Auto-Probe",
      "default": true
    },
    "allowNativeInputQueueFallback": {
      "type": "boolean",
      "title": "Allow AInputQueue Touch Hook",
      "default": true
    },
    "verifiedSignaturesReady": {
      "type": "boolean",
      "title": "Verified Signatures Ready",
      "default": false
    },
    "hudPlayerRendererRenderSig": {
      "type": "string",
      "title": "LivePlayerRenderer::render Signature Override",
      "default": ""
    },
    "getLocalPlayerFromClientSig": {
      "type": "string",
      "title": "ClientInstance::getLocalPlayer Signature Override",
      "default": ""
    },
    "actorGetRotationSig": {
      "type": "string",
      "title": "Actor::getRotation Signature Override",
      "default": ""
    },
    "actorRotYawOffset": {
      "type": "integer",
      "title": "Actor Yaw Offset",
      "default": 0
    },
    "actorRotPitchOffset": {
      "type": "integer",
      "title": "Actor Pitch Offset",
      "default": 0
    },
    "mobBodyYawOffset": {
      "type": "integer",
      "title": "Mob Body Yaw Offset",
      "default": 0
    },
    "mobHeadYawOffset": {
      "type": "integer",
      "title": "Mob Head Yaw Offset",
      "default": 0
    }
  },
  "required": [
    "version",
    "enabled",
    "cursorEnabled",
    "cursorSizePreset",
    "cursorScale",
    "greenSlotHoverEnabled",
    "paperDollFollowCursor",
    "hideWhenMouseConnected",
    "touchInputMode",
    "trackpadSensitivity",
    "sensitivityYaw",
    "sensitivityPitch",
    "invertVertical",
    "maxPitchDegrees",
    "resetOnInventoryClose",
    "smoothingFactor",
    "boundsMinX",
    "boundsMinY",
    "boundsMaxX",
    "boundsMaxY",
    "expectedMinecraftVersion",
    "allowSymbolAutoProbe",
    "allowNativeInputQueueFallback",
    "verifiedSignaturesReady",
    "hudPlayerRendererRenderSig",
    "getLocalPlayerFromClientSig",
    "actorGetRotationSig",
    "actorRotYawOffset",
    "actorRotPitchOffset",
    "mobBodyYawOffset",
    "mobHeadYawOffset"
  ]
}
